# Beispielkonfiguration – NIEMALS echte Secrets in diese Datei oder ins Repo eintragen.
# Kopieren nach ".env" und dort mit echten Werten befuellen. ".env" ist in .gitignore
# und wird nicht versioniert.

# --- Anwendung ---
APP_ENV=development

# --- Datenbank ---
# Prototyp: SQLite (lokale Datei). Produktion (spaeter): PostgreSQL-Connection-String.
# Die Datenzugriffsschicht wird ab Prompt 03/04 so abstrahiert, dass hier nur die
# DATABASE_URL getauscht werden muss, ohne Code-/Modelaenderungen.
DATABASE_URL=sqlite:///./data/kanzlei_ai.db

# --- Eingang / Intake ---
# Kommagetrennte Liste ueberwachter Ordnerpfade, z. B.:
# INTAKE_WATCHED_FOLDERS=["C:/Kanzlei/Eingang"]
INTAKE_WATCHED_FOLDERS=[]
# Sicherer Ablagebereich fuer kopierte Eingangsdateien (getrennt vom
# ueberwachten Quellordner).
INTAKE_STORAGE_DIR=data/intake

# --- LLM / Claude API (folgt erst ab Prompt 17, hier nur Platzhalter) ---
# ANTHROPIC_API_KEY=
CLAUDE_MODEL_NAME=claude-sonnet-5
CLAUDE_MAX_TOKENS=2000

# --- E-Mail ---
# "imap" ist der aktuell einzige implementierte Provider.
# MAIL_PROVIDER=imap
# MAIL_HOST=imap.beispiel-kanzlei.de
# MAIL_PORT=993
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_MAILBOX=INBOX
MAIL_USE_SSL=true
MAIL_MARK_SEEN=true
MAIL_ATTACHMENT_STORAGE_DIR=data/mail_attachments

# --- Klassifikation ---
CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=0.6

# --- Aktenzuordnung (Matter-Matching) ---
MATCHING_AUTO_ASSIGN_THRESHOLD=0.85
MATCHING_REVIEW_THRESHOLD=0.4

# --- Legal Research ---
RESEARCH_MIN_SCORE_FOR_SUFFICIENT=0.5

# --- Suche / Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- OCR ---
OCR_ENABLED=false
OCR_ENGINE=tesseract
# Nur setzen, falls Tesseract nicht automatisch gefunden wird, z. B. unter
# Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=deu+eng
MIN_EXTRACTED_TEXT_LENGTH=20

# --- Rechtsquellen (folgt erst ab Prompt 14/15, hier nur Platzhalter) ---
LEGAL_SOURCES_ALLOWED=[]

# --- Freigaberegeln ---
# Sicherer Default: nicht auf false setzen ohne ausdrueckliche fachliche
# Entscheidung (siehe CLAUDE.md Grundregeln zu Versand/Freigabe).
REQUIRE_HUMAN_APPROVAL_BEFORE_SEND=true

# --- Server-Bindung (Prompt 36, Windows-Installer) ---
# Sicherer Default: nur auf localhost erreichbar. Der Windows-Setup-
# Assistent (scripts/../app/setup/, Prompt 37) setzt diese Werte
# automatisch in die generierte Produktions-.env.
HOST=127.0.0.1
PORT=8000

# --- Vorlagen (folgt erst ab Prompt 39, hier nur Platzhalter) ---
TEMPLATES_DIR=data/templates

# --- Aufbewahrung / Loeschung (folgt erst ab Prompt 35, hier nur Platzhalter) ---
# 0 = keine automatische Loeschung
RETENTION_DAYS=0

# --- Authentifizierung / Sessions (Prompt 26) ---
# MUSS in Produktion gesetzt werden (langer, zufälliger Wert, z. B. via
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`). Ohne
# gesetzten Wert startet die App in Nicht-Entwicklungsumgebungen NICHT.
# SESSION_SECRET_KEY=
# Nur für lokale HTTP-Entwicklung ohne TLS auf False setzen - in
# Produktion IMMER True lassen (Cookie nur über HTTPS). Ohne diese
# Variable gilt automatisch: True außer wenn APP_ENV=development.
# SESSION_COOKIE_SECURE=False

# --- Initialer Admin-Nutzer (nur für scripts/create_admin.py, Prompt 26) ---
# Wird NICHT von der Anwendung selbst gelesen, nur vom einmaligen
# Setup-Skript. ADMIN_INITIAL_PASSWORD sollte nach dem ersten Login sofort
# geändert werden (wird erzwungen, siehe scripts/create_admin.py).
# ADMIN_EMAIL=
# ADMIN_INITIAL_PASSWORD=
