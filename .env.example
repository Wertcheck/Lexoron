# Beispielkonfiguration – NIEMALS echte Secrets in diese Datei oder ins Repo eintragen.
# Kopieren nach ".env" und dort mit echten Werten befuellen. ".env" ist in .gitignore
# und wird nicht versioniert.

# --- Anwendung ---
APP_ENV=development

# --- Datenbank ---
# Prototyp: SQLite (lokale Datei). Produktion (spaeter): PostgreSQL-Connection-String.
# Die Datenzugriffsschicht wird ab Prompt 03/04 so abstrahiert, dass hier nur die
# DATABASE_URL getauscht werden muss, ohne Code-/Modelaenderungen.
DATABASE_URL=sqlite:///./data/kanzlei_ai.db

# --- Eingang / Intake (Platzhalter, echte Logik erst Prompt 05) ---
# Kommagetrennte Liste ueberwachter Ordnerpfade, z. B.:
# INTAKE_WATCHED_FOLDERS=["C:/Kanzlei/Eingang"]
INTAKE_WATCHED_FOLDERS=[]

# --- LLM / Claude API (folgt erst ab Prompt 17, hier nur Platzhalter) ---
# ANTHROPIC_API_KEY=

# --- E-Mail (folgt erst ab Prompt 07, hier nur Platzhalter) ---
# MAIL_PROVIDER=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- OCR (folgt erst ab Prompt 06, hier nur Platzhalter) ---
OCR_ENABLED=false
# OCR_ENGINE=

# --- Rechtsquellen (folgt erst ab Prompt 14/15, hier nur Platzhalter) ---
LEGAL_SOURCES_ALLOWED=[]

# --- Freigaberegeln ---
# Sicherer Default: nicht auf false setzen ohne ausdrueckliche fachliche
# Entscheidung (siehe CLAUDE.md Grundregeln zu Versand/Freigabe).
REQUIRE_HUMAN_APPROVAL_BEFORE_SEND=true

# --- Vorlagen (folgt erst ab Prompt 39, hier nur Platzhalter) ---
TEMPLATES_DIR=data/templates

# --- Aufbewahrung / Loeschung (folgt erst ab Prompt 35, hier nur Platzhalter) ---
# 0 = keine automatische Loeschung
RETENTION_DAYS=0
